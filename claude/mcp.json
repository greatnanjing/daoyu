{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["chrome-devtools-mcp@latest"],
      "env": {}
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {}
    },
    "web-reader": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--with", "mcp~=1.0", "mcp-server-fetch"],
      "env": {}
    }
  },
  "disabled": ["chrome-devtools"]
}
