{
  "whitelist": [
    "your-wechat-user-id@im.wechat"
  ],
  "default_cwd": "/home/<user>/proj/daoyu",
  "claude_bin": "claude",
  "media_retention_days": 14,
  "throttle": {
    "min_send_interval_s": 1.0,
    "progress_window_s": 2.5,
    "page_char_limit": 2000,
    "daily_send_limit": 500
  },
  "budget": {
    "max_turns": 50,
    "max_usd": 5.0
  },
  "worker": {
    "concurrency": 3,
    "poll_interval_s": 0.5,
    "bg_poll_s": 10,
    "bg_blocked_timeout_s": 1800,
    "isolate_claude_config": false
  },
  "reconnect": {
    "session_duration_s": 2592000,
    "warning_before_s": 7200,
    "reminder_interval_s": 1800,
    "force_before_s": 1800,
    "qrcode_scan_timeout_s": 600,
    "silent_grace_s": 30
  },
  "cron": {
    "disk_threshold_pct": 85,
    "cpu_threshold_pct": 90,
    "mem_threshold_pct": 90,
    "load_sustain_min": 5,
    "cert_warn_days": 14,
    "cert_paths": ["/etc/letsencrypt/live"],
    "alert_silence_h": 6,
    "queue_backlog_warn": 20
  },
  "notify": {
    "listen": "127.0.0.1:8417",
    "http_enabled": true
  }
}